<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_pill_black"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/inc_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inc_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#8E8E93"
            android:textSize="15sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/inc_decline"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/notif_btn_red"
        android:contentDescription="Decline"
        android:padding="13dp"
        android:src="@drawable/notif_ic_end" />

    <ImageView
        android:id="@+id/inc_accept"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/notif_btn_green"
        android:contentDescription="Accept"
        android:padding="13dp"
        android:src="@drawable/notif_ic_accept" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_pill_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/notif_avatar_bg"
        android:padding="8dp"
        android:src="@drawable/notif_ic_person" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="mobile"
            android:textColor="#A1A1A6"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/inc_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/inc_decline"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/notif_btn_red"
        android:contentDescription="Decline"
        android:padding="9dp"
        android:src="@drawable/notif_ic_end" />

    <ImageView
        android:id="@+id/inc_accept"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/notif_btn_green"
        android:contentDescription="Accept"
        android:padding="9dp"
        android:src="@drawable/notif_ic_accept" />
</LinearLayout>

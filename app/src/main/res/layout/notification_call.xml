<?xml version="1.0" encoding="utf-8"?>
<!-- No background: the system notification surface shows through, so it follows light/dark mode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_name"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true" />

        <Chronometer
            android:id="@+id/notif_timer"
            style="@android:style/TextAppearance.Material.Notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/notif_status"
            style="@android:style/TextAppearance.Material.Notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calling…"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/notif_mute"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/notif_btn_gray"
        android:contentDescription="Mute"
        android:padding="11dp"
        android:src="@drawable/notif_ic_mic_white" />

    <ImageView
        android:id="@+id/notif_speaker"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/notif_btn_gray"
        android:contentDescription="Speaker"
        android:padding="11dp"
        android:src="@drawable/notif_ic_speaker_white" />

    <ImageView
        android:id="@+id/notif_end"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/notif_btn_red"
        android:contentDescription="Hang up"
        android:padding="11dp"
        android:src="@drawable/notif_ic_end" />
</LinearLayout>
